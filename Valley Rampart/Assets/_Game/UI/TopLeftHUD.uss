/* ===== TopLeftHUD 左上角 HUD ===== */

.topleft-hud-root {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 220px;
    padding: 12px 16px;
    background-color: rgba(15, 15, 25, 0.75);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.5);
    pointer-events: none;
}

/* ===== 君主信息 ===== */
.monarch-block {
    margin-bottom: 12px;
}

.hp-bar-bg {
    width: 100%;
    height: 18px;
    background-color: rgb(25, 25, 35);
    border-radius: 9px;
    overflow: hidden;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.6);
}

.hp-bar-fill {
    height: 100%;
    background-color: rgb(80, 200, 80);
    width: 100%;
    transition-property: width;
    transition-duration: 0.2s;
}

.hp-text {
    font-size: 14px;
    color: rgb(200, 200, 210);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-bottom: 8px;
}

.attr-row {
    flex-direction: row;
    justify-content: space-between;
}

.attr-cell {
    flex-direction: column;
    align-items: center;
}

.attr-label {
    font-size: 12px;
    color: rgb(160, 160, 175);
}

.attr-value {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* ===== 时间信息 ===== */
.time-block {
    flex-direction: column;
}

.day-text {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.time-text {
    font-size: 14px;
    color: rgb(200, 200, 210);
    margin-bottom: 3px;
}

.season-text {
    font-size: 14px;
    color: rgb(240, 200, 80);
    -unity-font-style: bold;
}

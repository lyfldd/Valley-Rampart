<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/_Game/UI/Theme.uss" />
    <ui:VisualElement name="character-creation-root" class="screen-root">
        <ui:VisualElement class="creation-container">
            <ui:Label text="创建角色" class="creation-title" />

            <ui:VisualElement class="creation-form">
                <!-- 开局选族（2_20 M10 / D431 UI 侧：四族真数据选族卡，HH.66 段A 接 RaceDef 资产；
                     静态结构优先（SaveSlots 教训：动态创建按钮虚拟设备点击不触发），运行时只填数据+绑点击；
                     与王国名/地图档位同屏（2_13 §5.4B） -->
                <ui:VisualElement class="form-row">
                    <ui:Label text="种族" class="form-label" />
                    <ui:VisualElement name="race-card-row" class="race-card-row">
                        <ui:Button name="race-card-0" class="race-card" text="">
                            <ui:VisualElement name="race-banner-0" class="race-banner" />
                            <ui:Label name="race-name-0" text="人类" class="race-name" />
                            <ui:Label name="race-desc-0" text="" class="race-desc" />
                        </ui:Button>
                        <ui:Button name="race-card-1" class="race-card" text="">
                            <ui:VisualElement name="race-banner-1" class="race-banner" />
                            <ui:Label name="race-name-1" text="精灵" class="race-name" />
                            <ui:Label name="race-desc-1" text="" class="race-desc" />
                        </ui:Button>
                        <ui:Button name="race-card-2" class="race-card" text="">
                            <ui:VisualElement name="race-banner-2" class="race-banner" />
                            <ui:Label name="race-name-2" text="矮人" class="race-name" />
                            <ui:Label name="race-desc-2" text="" class="race-desc" />
                        </ui:Button>
                        <ui:Button name="race-card-3" class="race-card" text="">
                            <ui:VisualElement name="race-banner-3" class="race-banner" />
                            <ui:Label name="race-name-3" text="兽人" class="race-name" />
                            <ui:Label name="race-desc-3" text="" class="race-desc" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 王国名 -->
                <ui:VisualElement class="form-row">
                    <ui:Label text="王国名" class="form-label" />
                    <ui:TextField name="kingdom-name-input" value="河谷王国" max-length="12" class="form-input" />
                </ui:VisualElement>

                <!-- 难度（下拉选择） -->
                <ui:VisualElement class="form-row">
                    <ui:Label text="难度" class="form-label" />
                    <ui:DropdownField name="difficulty-select" label="" class="form-select"
                                      choices="简单,普通,困难" value="普通" />
                </ui:VisualElement>

                <!-- 地图大小（下拉选择） -->
                <ui:VisualElement class="form-row">
                    <ui:Label text="地图大小" class="form-label" />
                    <ui:DropdownField name="map-size-select" label="" class="form-select"
                                      choices="小,中,大" value="中" />
                </ui:VisualElement>

                <!-- 世界种子（0=随机） -->
                <ui:VisualElement class="form-row">
                    <ui:Label text="世界种子" class="form-label" />
                    <ui:IntegerField name="world-seed-input" value="0" class="form-input" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="form-actions">
                <ui:Button name="creation-back-button" text="返回" class="form-button" />
                <ui:Button name="creation-confirm-button" text="开始游戏" class="form-button form-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
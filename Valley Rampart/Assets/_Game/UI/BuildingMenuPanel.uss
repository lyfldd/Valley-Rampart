/* ===== BuildingMenuPanel 建造菜单面板 ===== */

.menu-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.menu-panel {
    width: 520px;
    height: 680px;
    background-color: rgb(35, 35, 50);
    border-radius: 12px;
    padding: 20px;
    align-items: stretch;
    border-width: 1px;
    border-color: rgb(60, 60, 80);
    flex-direction: column;
}

/* ===== 标题 ===== */
.menu-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 80);
    cursor: grab;
}

.menu-header:active {
    cursor: grabbing;
}

.menu-title {
    font-size: 26px;
    color: rgb(220, 170, 80);
    -unity-font-style: bold;
}

.menu-close {
    width: 32px;
    height: 32px;
    font-size: 22px;
    color: rgb(150, 150, 160);
    background-color: transparent;
    border-radius: 4px;
    border-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.menu-close:hover {
    background-color: rgb(85, 85, 110);
    color: rgb(180, 70, 70);
}

/* ===== 分类 Tab ===== */
.category-tabs {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px;
}

.tab-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 38px;
    font-size: 14px;
    color: rgb(150, 150, 160);
    background-color: rgb(60, 60, 80);
    border-radius: 6px;
    border-width: 0;
    margin: 0 2px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.tab-button:hover {
    background-color: rgb(85, 85, 110);
    color: rgb(230, 230, 230);
}

.tab-button--active {
    background-color: rgb(220, 170, 80);
    color: rgb(20, 20, 28);
    -unity-font-style: bold;
}

.tab-button--active:hover {
    background-color: rgb(240, 200, 120);
    color: rgb(20, 20, 28);
}

/* ===== 建筑列表（ScrollView：内容多时真正滚动，不被挤压） ===== */
.building-list {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 120px;
    max-height: 420px;
    margin-bottom: 12px;
    padding: 2px 2px;
}

/* ScrollView 内容容器：铺满可滚动区域，卡片纵向自然排列 */
.building-list .unity-scroll-view__content-container {
    flex-grow: 1;
    align-items: stretch;
}

/* ===== 单建筑条目 ===== */
.building-card {
    background-color: rgb(28, 28, 40);
    border-radius: 8px;
    padding: 12px 14px;
    margin: 6px 0;
    border-width: 1px;
    border-color: rgb(50, 50, 68);
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.building-card:hover {
    background-color: rgb(38, 38, 55);
    border-color: rgb(220, 170, 80);
}

.building-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
}

.building-card__name {
    font-size: 18px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
}

.building-card__build-btn {
    height: 32px;
    min-width: 64px;
    font-size: 14px;
    color: rgb(20, 20, 28);
    background-color: rgb(220, 170, 80);
    border-radius: 4px;
    border-width: 0;
    margin: 0;
    padding: 0 14px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.building-card__build-btn:hover {
    background-color: rgb(240, 200, 120);
}

.building-card__build-btn:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(100, 100, 100);
}

.building-card__desc {
    font-size: 13px;
    color: rgb(150, 150, 160);
    margin-bottom: 8px;
    white-space: normal;
}

.building-card__stats {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.building-card__stat-cell {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.building-card__stat-label {
    font-size: 11px;
    color: rgb(120, 120, 135);
}

.building-card__stat-value {
    font-size: 13px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
}

.building-card__cost-row {
    flex-direction: row;
    justify-content: flex-start;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgb(50, 50, 68);
    flex-wrap: wrap;
}

.cost-item {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
    margin-top: 2px;
}

.cost-item__icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    border-radius: 2px;
}

.cost-item__icon--gold { background-color: rgb(220, 180, 80); }
.cost-item__icon--stone { background-color: rgb(140, 140, 140); }
.cost-item__icon--wood { background-color: rgb(120, 80, 40); }
.cost-item__icon--food { background-color: rgb(150, 200, 90); }

.cost-item__value {
    font-size: 13px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
}

.cost-item__value--insufficient {
    color: rgb(210, 90, 90);
}

/* ===== 空状态提示 ===== */
.empty-list-hint {
    align-items: center;
    padding: 40px 0;
}

.empty-list-hint-text {
    font-size: 15px;
    color: rgb(150, 150, 160);
    -unity-font-style: italic;
}

/* ===== 底部提示 ===== */
.menu-hint-row {
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(60, 60, 80);
    align-items: center;
}

.menu-hint {
    font-size: 12px;
    color: rgb(150, 150, 160);
    -unity-font-style: italic;
}

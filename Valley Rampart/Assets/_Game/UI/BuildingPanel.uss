/* ===== BuildingPanel 建筑面板 ===== */

.building-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: flex-start;
    justify-content: flex-end;
    padding: 32px;
}

.building-panel {
    width: 320px;
    background-color: rgb(35, 35, 50);
    border-radius: 10px;
    padding: 20px;
    align-items: stretch;
    border-width: 1px;
    border-color: rgb(60, 60, 80);
}

/* ===== 标题区（可拖动窗口把手） ===== */
.header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 80);
    cursor: grab;
}

.header-row:active {
    cursor: grabbing;
}

.title-block {
    flex-direction: column;
    flex-grow: 1;
}

.building-name {
    font-size: 22px;
    color: rgb(220, 170, 80);
    -unity-font-style: bold;
}

.building-level {
    font-size: 12px;
    color: rgb(150, 150, 160);
    margin-top: 2px;
}

.close-button {
    width: 32px;
    height: 32px;
    font-size: 22px;
    color: rgb(150, 150, 160);
    background-color: transparent;
    border-radius: 4px;
    border-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgb(85, 85, 110);
    color: rgb(180, 70, 70);
}

/* ===== HP 条 ===== */
.hp-row {
    flex-direction: column;
    margin-bottom: 14px;
}

.hp-bar-bg {
    width: 100%;
    height: 12px;
    background-color: rgb(30, 30, 40);
    border-radius: 6px;
    overflow: hidden;
}

.hp-bar-fill {
    height: 100%;
    background-color: rgb(100, 180, 100);
    width: 100%;
    transition-property: width;
    transition-duration: 0.2s;
}

.hp-text {
    font-size: 12px;
    color: rgb(150, 150, 160);
    margin-top: 4px;
    -unity-text-align: middle-right;
}

/* ===== 描述 ===== */
.desc-block {
    margin-bottom: 12px;
    padding: 8px 10px;
    background-color: rgb(28, 28, 40);
    border-radius: 4px;
}

.building-desc {
    font-size: 12px;
    color: rgb(150, 150, 160);
    -unity-font-style: italic;
    white-space: normal;
}

/* ===== 通用信息行 ===== */
.info-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 8px 10px;
    background-color: rgb(28, 28, 40);
    border-radius: 4px;
}

.info-cell {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.info-label {
    font-size: 12px;
    color: rgb(150, 150, 160);
    margin-bottom: 2px;
}

.info-value {
    font-size: 16px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
}

/* ===== 操作按钮 ===== */
.action-button {
    height: 44px;
    margin-top: 8px;
    font-size: 16px;
    color: rgb(230, 230, 230);
    background-color: rgb(60, 60, 80);
    border-radius: 6px;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.action-button:hover {
    background-color: rgb(85, 85, 110);
}

.action-button:active {
    background-color: rgb(220, 170, 80);
    color: rgb(20, 20, 28);
}

.action-button:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(100, 100, 100);
}

.action-button--primary {
    background-color: rgb(220, 170, 80);
    color: rgb(20, 20, 28);
}

.action-button--primary:hover {
    background-color: rgb(240, 200, 120);
    color: rgb(20, 20, 28);
}

.action-button--danger {
    background-color: rgb(80, 40, 40);
}

.action-button--danger:hover {
    background-color: rgb(180, 70, 70);
}

/* ===== 功能区（3.5 建筑级功能） ===== */
.function-area {
    margin-top: 4px;
}

.function-title {
    font-size: var(--font-size-small);
    color: var(--color-accent);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.function-rows {
    flex-direction: column;
    align-items: stretch;
}

.spacer {
    height: 10px;
}

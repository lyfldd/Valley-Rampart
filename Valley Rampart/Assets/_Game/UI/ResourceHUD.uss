/* ===== ResourceHUD 右上角资源面板 ===== */

.resource-hud-root {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 400px;
    padding: 10px 16px;
    background-color: rgba(15, 15, 25, 0.75);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.5);
    pointer-events: none;
    flex-direction: column;
    align-items: flex-end;
}

/* 整体幸福度徽标（主菜单时由代码隐藏） */
.happiness-badge {
    font-size: 15px;
    color: var(--color-accent);
    -unity-font-style: bold;
    background-color: var(--color-bg-panel);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--color-accent);
    padding: 2px 12px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

/* 资源行：6 项 flex-wrap 自动两行排列，不拥挤 */
.resource-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
}

.res-item {
    flex-direction: row;
    align-items: center;
    min-width: 118px;
    margin-bottom: 4px;
}

/* 色块图标 */
.res-icon {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
}

.res-icon--gold { background-color: rgb(240, 200, 80); }
.res-icon--stone { background-color: rgb(170, 170, 170); }
.res-icon--wood { background-color: rgb(150, 100, 50); }
.res-icon--food { background-color: rgb(160, 220, 100); }
.res-icon--special-food { background-color: rgb(200, 140, 220); }
.res-icon--meat { background-color: rgb(210, 110, 90); }

/* 资源名称（弱化） */
.res-name {
    font-size: 15px;
    color: var(--color-text-muted);
    margin-right: 4px;
    white-space: nowrap;
}

/* 资源数值（高亮） */
.res-value {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}
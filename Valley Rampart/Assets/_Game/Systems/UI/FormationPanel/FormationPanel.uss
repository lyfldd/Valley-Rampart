/* ===== FormationPanel 作战面板样式（3.0.1_5 §六 P2） =====
   挂载：GameScene 的 FormationPanelUI GameObject（UIDocument）
   风格：高对比 + 居中面板 + 可拖拽标题栏 + 右上关闭（参考 AIDebugPanel）
   颜色/字号一律复用 Theme.uss 全局变量，禁止硬编码重复值 */

/* 面板壳（absolute + left/top 由代码设置，支持拖拽；初始居中） */
.formation-panel-root {
    position: absolute;
    width: 540px;
    align-items: center;
    justify-content: center;
}

/* 面板主体 */
.formation-panel {
    width: 100%;
    background-color: var(--color-bg-panel);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--color-accent);
    overflow: hidden;
}

/* ===== 标题栏（可拖拽） ===== */
.formation-title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    cursor: move;
}

.formation-title {
    font-size: 22px;
    color: var(--color-accent);
    -unity-font-style: bold;
}

.formation-close-button {
    width: 28px;
    height: 28px;
    font-size: 16px;
    color: var(--color-text-muted);
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    padding: 0;
    -unity-text-align: middle-center;
}

.formation-close-button:hover {
    background-color: rgba(255, 80, 80, 0.3);
    color: rgb(255, 100, 100);
}

.formation-close-button:active {
    background-color: rgba(255, 80, 80, 0.5);
}

/* ===== 内容区 ===== */
.formation-content {
    padding: 16px;
}

/* ===== 编队列表 ===== */
.formation-list {
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 8px;
}

.formation-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: transparent;
    cursor: pointer;
}

.formation-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* 选中高亮（BEM 修饰类，由 C# 切换） */
.formation-row--selected {
    background-color: rgba(220, 170, 80, 0.25);
    border-color: var(--color-accent);
}

.formation-row-name {
    font-size: var(--font-size-label);
    color: var(--color-text-primary);
    -unity-font-style: bold;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.formation-row-faction {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    width: 52px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* 敌方阵营红色标注 */
.formation-row-faction--enemy {
    color: var(--color-danger);
}

.formation-row-intent {
    font-size: var(--font-size-label);
    color: var(--color-accent);
    width: 56px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.formation-row-count {
    font-size: var(--font-size-label);
    color: var(--color-text-primary);
    width: 56px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* 空列表提示 */
.formation-empty-hint {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    padding: 16px 0;
}

/* 选中信息 */
.selection-info {
    font-size: var(--font-size-small);
    color: var(--color-text-primary);
    margin-bottom: 12px;
}

/* ===== 军令区 ===== */
.order-section {
    margin-bottom: 12px;
}

.section-title {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    margin-bottom: 6px;
}

.order-button-row {
    flex-direction: row;
    justify-content: space-between;
    /* 负 margin 抵消按钮两侧 4px 间距（UI Toolkit 不支持 :first-child/:last-child） */
    margin-left: -4px;
    margin-right: -4px;
}

.order-button {
    flex-grow: 1;
    height: 44px;
    margin: 0 4px;
    font-size: var(--font-size-label);
    color: var(--color-text-primary);
    background-color: var(--color-button);
    border-radius: 6px;
    border-width: 0;
    -unity-font-style: bold;
}

.order-button:hover {
    background-color: var(--color-button-hover);
}

.order-button:active {
    background-color: var(--color-accent);
    color: var(--color-bg-dark);
}

.order-button:disabled {
    background-color: var(--color-disabled);
    color: rgb(100, 100, 100);
}

/* 进攻/撤退 hover 色调区分 */
.order-button--charge:hover {
    background-color: rgb(130, 75, 40);
}

.order-button--retreat:hover {
    background-color: rgb(90, 60, 90);
}

/* 君主令按钮：金色描边 + 暗金底（表示"不顾一切"特殊军令） */
.order-button--royal {
    background-color: rgb(70, 55, 30);
    color: var(--color-accent);
    border-width: 1px;
    border-color: var(--color-accent);
}

.order-button--royal:hover {
    background-color: var(--color-accent);
    color: var(--color-bg-dark);
}

.order-button--royal:disabled {
    background-color: var(--color-disabled);
    border-color: var(--color-disabled);
    color: rgb(100, 100, 100);
}

/* ===== 底部操作行 ===== */
.formation-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.formation-footer-button {
    height: 36px;
    padding: 0 16px;
    font-size: var(--font-size-small);
    color: var(--color-text-primary);
    background-color: var(--color-button);
    border-radius: 6px;
    border-width: 0;
}

.formation-footer-button:hover {
    background-color: var(--color-button-hover);
}

.footer-hint {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
}

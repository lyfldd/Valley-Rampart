/* ===== AI 调试面板样式 ===== */

/* ===== 屏幕中间：开发者模式面板 ===== */
.dev-panel-root {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    align-items: center;
    justify-content: center;
}

.dev-panel {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 12px;
    padding: 32px;
    align-items: center;
    border-width: 2px;
    border-color: var(--color-accent);
}

.dev-title {
    font-size: 32px;
    color: var(--color-accent);
    -unity-font-style: bold;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.dev-button {
    width: 100%;
    height: 56px;
    font-size: 20px;
    color: var(--color-bg-dark);
    background-color: var(--color-accent);
    border-radius: 8px;
    border-width: 0;
    margin-bottom: 24px;
    -unity-font-style: bold;
}

.dev-button:hover {
    background-color: var(--color-accent-hover);
}

.dev-button:active {
    background-color: rgb(200, 150, 60);
}

.dev-hints {
    width: 100%;
    padding: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

.dev-hint-title {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.dev-hint {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-top: 4px;
}

/* ===== 左上角：AI 状态面板 ===== */
.status-panel-root {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 380px;
}

.status-panel {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(60, 60, 80);
    overflow: hidden;
}

/* 标题栏 */
.title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 80);
}

.panel-title {
    font-size: 16px;
    color: var(--color-accent);
    -unity-font-style: bold;
}

.npc-name {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    flex-grow: 1;
    margin-left: 8px;
}

.collapse-icon {
    font-size: 14px;
    color: var(--color-text-muted);
    width: 20px;
    -unity-text-align: middle-center;
}

/* 内容区 */
.content-area {
    padding: 12px 16px;
}

/* 通用区块 */
.section {
    margin-bottom: 16px;
}

.section-title {
    font-size: 14px;
    color: var(--color-accent);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.section-body {
    padding-left: 8px;
}

/* 字段行 */
.field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.field-label {
    font-size: 13px;
    color: var(--color-text-muted);
    width: 80px;
    flex-shrink: 0;
}

.field-value {
    font-size: 13px;
    color: var(--color-text-primary);
    -unity-font-style: normal;
    flex-grow: 1;
}

/* ===== 谱系色块 ===== */
.spectrum-row {
    flex-direction: row;
    align-items: center;
}

.spectrum-color {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: rgb(100, 100, 100); /* 默认灰色，代码动态设置 */
}

.spectrum-name {
    font-size: 14px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

/* ===== 威胁等级色块 ===== */
.threat-badge-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.threat-color {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 6px;
    background-color: rgb(100, 100, 100); /* 默认灰色，代码动态设置 */
}

/* ===== 刺激源排行 ===== */
.stimuli-list {
    padding-left: 8px;
}

.stim-line {
    font-size: 12px;
    color: var(--color-text-primary);
    margin-bottom: 4px;
    -unity-font-style: normal;
}

/* ===== 切换历史 ===== */
.switch-list {
    padding-left: 8px;
}

.switch-line {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
    -unity-font-style: normal;
}

/* ===== 底部统计区 ===== */
.stats-section {
    margin-top: 16px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(60, 60, 80);
}

/* HP 条 */
.hp-row {
    flex-direction: column;
    margin-bottom: 12px;
}

.hp-bar-bg {
    width: 100%;
    height: 16px;
    background-color: rgb(30, 30, 40);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 4px;
}

.hp-bar-fill {
    height: 100%;
    background-color: rgb(100, 180, 100);
    width: 100%;
    transition-property: width;
    transition-duration: 0.2s;
}

.hp-text {
    font-size: 13px;
    color: var(--color-text-muted);
    -unity-text-align: middle-right;
}

/* ===== 顶部提示条 ===== */
.hint-bar {
    position: absolute;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(220, 170, 80, 0.9);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.hint-text {
    font-size: 16px;
    color: var(--color-bg-dark);
    -unity-font-style: bold;
}

/* ===== 隐藏状态 ===== */
.is-hidden {
    display: none;
}

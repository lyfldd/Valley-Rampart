/* ===== AI 调试面板样式 ===== */

/* ===== 屏幕中间：开发者模式面板（居中 + 可拖拽） ===== */
.dev-panel-root {
    position: absolute;
    width: 400px;
    align-items: center;
    justify-content: center;
    /* left/top 由代码动态设置（初始居中） */
}

.dev-panel {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 12px;
    padding: 0;
    align-items: stretch;
    border-width: 2px;
    border-color: var(--color-accent);
    overflow: hidden;
}

/* 标题栏（可拖拽） */
.dev-title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    cursor: move;
}

.dev-title-text {
    font-size: 22px;
    color: var(--color-accent);
    -unity-font-style: bold;
}

/* 开发者面板关闭按钮 */
.dev-close-button {
    width: 28px;
    height: 28px;
    font-size: 16px;
    color: var(--color-text-muted);
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    padding: 0;
    -unity-text-align: middle-center;
}

.dev-close-button:hover {
    background-color: rgba(255, 80, 80, 0.3);
    color: rgb(255, 100, 100);
}

.dev-close-button:active {
    background-color: rgba(255, 80, 80, 0.5);
}

/* 开发者面板内容区（Tab + 按钮等） */
.dev-panel-content {
    padding: 16px;
    align-items: center;
}

.dev-button {
    width: 100%;
    height: 56px;
    font-size: 20px;
    color: var(--color-bg-dark);
    background-color: var(--color-accent);
    border-radius: 8px;
    border-width: 0;
    margin-bottom: 16px;
    -unity-font-style: bold;
}

.dev-button:hover {
    background-color: var(--color-accent-hover);
}

.dev-button:active {
    background-color: rgb(200, 150, 60);
}

/* ===== Tab 按钮行 ===== */
.tab-bar {
    flex-direction: row;
    width: 100%;
    margin-bottom: 16px;
    border-radius: 8px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.05);
}

.tab-button {
    flex-grow: 1;
    height: 40px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

.tab-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.tab-active {
    background-color: var(--color-accent);
}

.tab-active .tab-label {
    color: var(--color-bg-dark);
}

/* 禁用态：另一个 Tab 激活时，当前 Tab 灰显且不可点击 */
.tab-disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.tab-disabled:hover {
    background-color: transparent;
}

.tab-label {
    font-size: 16px;
    color: var(--color-text-muted);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ===== Tab 内容区 ===== */
.tab-content {
    width: 100%;
}

/* ===== 放置按钮容器（左右两列） ===== */
.spawn-buttons-container {
    flex-direction: row;
    width: 100%;
}

/* 放置按钮滚动窗口 */
.spawn-scroll {
    height: 280px;
    width: 100%;
    margin-bottom: 8px;
    -unity-scroll-deceleration-rate: 0.5;  /* 减速更快（默认 0.135，惯性滚动更短） */
    -unity-elastic-curve: 0.1 0.1 0.1 1;   /* 弹性更弱 */
}

/* 左/右列容器 */
.spawn-column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    padding: 0 4px;
}

.spawn-type-button {
    width: 100%;
    height: 44px;
    font-size: 16px;
    color: var(--color-text-primary);
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    margin-bottom: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.spawn-type-button:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: var(--color-accent);
}

.spawn-type-button:active {
    background-color: var(--color-accent);
    color: var(--color-bg-dark);
}

.spawn-selected {
    background-color: var(--color-accent);
    color: var(--color-bg-dark);
    border-color: var(--color-accent);
}

.spawn-hint {
    font-size: 14px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    margin-top: 8px;
    width: 100%;
}

.dev-hints {
    width: 100%;
    padding: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

.dev-hint-title {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.dev-hint {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-top: 4px;
}

/* ===== 左上角：AI 状态面板 ===== */
.status-panel-root {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 380px;
    height: 400px;
}

.status-panel {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(60, 60, 80);
    overflow: hidden;
    flex-direction: column;
}

/* 标题栏 */
.title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 80);
    cursor: move;
}

/* 关闭按钮 */
.close-button {
    width: 24px;
    height: 24px;
    font-size: 14px;
    color: var(--color-text-muted);
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    margin-left: 8px;
    padding: 0;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgba(255, 80, 80, 0.3);
    color: rgb(255, 100, 100);
}

.close-button:active {
    background-color: rgba(255, 80, 80, 0.5);
}

.panel-title {
    font-size: 16px;
    color: var(--color-accent);
    -unity-font-style: bold;
}

.npc-name {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    flex-grow: 1;
    margin-left: 8px;
}

.collapse-icon {
    font-size: 14px;
    color: var(--color-text-muted);
    width: 20px;
    -unity-text-align: middle-center;
}

/* 内容区 */
.content-area {
    padding: 12px 16px;
}

/* 状态面板滚动窗口 */
.status-scroll {
    height: 340px;
    width: 100%;
}

/* 通用区块 */
.section {
    margin-bottom: 16px;
}

.section-title {
    font-size: 14px;
    color: var(--color-accent);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.section-body {
    padding-left: 8px;
}

/* 字段行 */
.field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.field-label {
    font-size: 13px;
    color: var(--color-text-muted);
    width: 80px;
    flex-shrink: 0;
}

.field-value {
    font-size: 13px;
    color: var(--color-text-primary);
    -unity-font-style: normal;
    flex-grow: 1;
}

/* ===== 谱系色块 ===== */
.spectrum-row {
    flex-direction: row;
    align-items: center;
}

.spectrum-color {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: rgb(100, 100, 100); /* 默认灰色，代码动态设置 */
}

.spectrum-name {
    font-size: 14px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

/* ===== 威胁等级色块 ===== */
.threat-badge-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.threat-color {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 6px;
    background-color: rgb(100, 100, 100); /* 默认灰色，代码动态设置 */
}

/* ===== 刺激源排行 ===== */
.stimuli-list {
    padding-left: 8px;
}

.stim-line {
    font-size: 12px;
    color: var(--color-text-primary);
    margin-bottom: 4px;
    -unity-font-style: normal;
}

/* ===== 切换历史 ===== */
.switch-list {
    padding-left: 8px;
}

.switch-line {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
    -unity-font-style: normal;
}

/* ===== 底部统计区 ===== */
.stats-section {
    margin-top: 16px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(60, 60, 80);
}

/* HP 条 */
.hp-row {
    flex-direction: column;
    margin-bottom: 12px;
}

.hp-bar-bg {
    width: 100%;
    height: 16px;
    background-color: rgb(30, 30, 40);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 4px;
}

.hp-bar-fill {
    height: 100%;
    background-color: rgb(100, 180, 100);
    width: 100%;
    transition-property: width;
    transition-duration: 0.2s;
}

.hp-text {
    font-size: 13px;
    color: var(--color-text-muted);
    -unity-text-align: middle-right;
}

/* ===== 顶部提示条 ===== */
.hint-bar {
    position: absolute;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(220, 170, 80, 0.9);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.hint-text {
    font-size: 16px;
    color: var(--color-bg-dark);
    -unity-font-style: bold;
}

/* ===== 隐藏状态 ===== */
.is-hidden {
    display: none;
}
